// For format details, see https://aka.ms/devcontainer.json
{
  "name": "hyperswitch-stack",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.12"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": ["tamasfe.even-better-toml", "rust-lang.rust-analyzer"]
    }
  },
  "forwardPorts": [8080, 9000, 9050, 8090, 8025],
  "portsAttributes": {
    "8080": {
      "label": "Hyperswitch API",
      "onAutoForward": "notify"
    },
    "9000": {
      "label": "Control Center",
      "onAutoForward": "notify"
    },
    "9050": {
      "label": "Web SDK",
      "onAutoForward": "silent"
    },
    "8090": {
      "label": "Pool Wallet API",
      "onAutoForward": "silent"
    },
    "8025": {
      "label": "MailHog",
      "onAutoForward": "silent"
    }
  },
  "postCreateCommand": "docker --version && docker compose version"
}
